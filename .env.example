# ============================================
# SPORTS BETTING ANALYTICS - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env
# NEVER commit .env to git!

# ============================================
# REQUIRED API KEYS
# ============================================

# Claude AI API Key (Anthropic) - Required for AI analysis
# Get your key at: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# The Odds API Key (Live Sports Odds) - Required for odds data
# Get your key at: https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# ============================================
# OPTIONAL API KEYS
# ============================================

# OpenWeatherMap API Key (Weather Intelligence)
# Get your key at: https://openweathermap.org/api
# Free tier: 1000 calls/day
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# College Football Data API Key (CFB Advanced Stats)
# Get your key at: https://collegefootballdata.com/
CFB_API_KEY=your_cfb_api_key_here

# College Basketball Data API Key (CBB Advanced Stats)
# Get your key at: https://collegebasketballdata.com/
CBB_API_KEY=your_cbb_api_key_here

# API-Football Key (Soccer/Football Data)
# Get your key at: https://www.api-football.com/
# Free tier: 100 requests/day
APIFOOTBALL_API_KEY=your_apifootball_api_key_here

# ============================================
# DATABASE (Production/Docker)
# ============================================
DB_PASSWORD=your_secure_database_password

# ============================================
# NOTES
# ============================================
# - CLAUDE_API_KEY and ODDS_API_KEY are required for core functionality
# - Other API keys enable additional features but are optional
# - For local development, MySQL runs on localhost:3306
# - For Docker deployment, PostgreSQL runs on db:5432
